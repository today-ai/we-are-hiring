rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'airev.pk@gmail.com' ||
        request.auth.token.email == 'shakeelsaeedofficial@gmail.com'
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Candidate Applications (Admin has full power, candidates can create and manage their own)
    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Interview Sessions
    match /interviews/{interviewId} {
      allow read, write: if true;
    }

    // Scheduled Interviews
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Available Interview Slots for Self-Scheduling
    match /slots/{slotId} {
      allow read, write: if true;
    }

    // System Settings & Email Configuration
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}

